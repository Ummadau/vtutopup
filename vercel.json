{
  "version": 2,
  "rewrites": [
    {
      "source": "/hooks/deposits",
      "destination": "/api/hooks/deposits"
    },
    {
      "source": "/hooks/deposits/(.*)",
      "destination": "/api/hooks/deposits"
    },
    {
      "source": "/webhooks/unitybills",
      "destination": "/api/webhooks/unitybills"
    },
    {
      "source": "/((?!api/|hooks/|webhooks/).*)",
      "destination": "/index.html"
    }
  ]
}
