{
  "version": 2,
  "rewrites": [
    {
      "source": "/hooks/deposits",
      "destination": "/api/index.js"
    },
    {
      "source": "/hooks/deposits/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/webhooks/unitybills",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|hooks/|webhooks/).*)",
      "destination": "/index.html"
    }
  ]
}
