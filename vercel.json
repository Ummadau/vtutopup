{
  "rewrites": [
    {
      "source": "/hooks/deposits",
      "destination": "/api/hooks/deposits"
    },
    {
      "source": "/hooks/deposits/(.*)",
      "destination": "/api/hooks/deposits"
    },
    {
      "source": "/api/webhooks/unitybills",
      "destination": "/api/webhooks/unitybills"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
