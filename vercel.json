{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/index.js": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/hooks/deposits",
      "destination": "/api"
    },
    {
      "source": "/hooks/deposits/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhooks/unitybills",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|hooks/|webhooks/).*)",
      "destination": "/index.html"
    }
  ]
}
