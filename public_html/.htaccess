# NAEEM DATA SUB / NPay Shared Hosting (public_html) Security, MIME & Routing Rules

Options -Indexes

# Ensure ES module scripts and stylesheets are always served with valid MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
</IfModule>

# Block direct HTTP access to sensitive configuration, database dumps, and lock files
<FilesMatch "^(\.env.*|\.install\.lock|persisted_db\.json|package(-lock)?\.json|bun\.lock|composer\.(json|lock)|.*\.sql|.*\.ts|.*\.tsx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Normalize nested SPA route requests for ./assets/...
  RewriteRule ^.+/assets/(.*)$ assets/$1 [L]

  # Allow existing static files, assets, and PHP scripts directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite API or webhook routes to index.html
  RewriteRule ^(api|hooks|webhooks)(/|$) - [L]

  # Single-Page App fallback when compiled index.html exists in this folder
  RewriteRule ^ index.html [L]
</IfModule>
